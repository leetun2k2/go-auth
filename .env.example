# ==============================================================================
# Go Auth - Runtime Environment Configuration Example
# ==============================================================================
# Copy this file to .env and replace required blank values before startup.
# Process environment values take priority over values defined in configuration files.
# Nested configuration keys use double-underscore separators (e.g. SERVER__ADMIN_ADDR).

# ------------------------------------------------------------------------------
# 1. LOGGER CONFIGURATION
# ------------------------------------------------------------------------------
# Set to false for human-readable console output, true for JSON structured logs.
LOGGER__PRODUCTION=false

# ------------------------------------------------------------------------------
# 2. SERVER CONFIGURATION (Admin / Ops Server)
# ------------------------------------------------------------------------------
# Application name identifier used in logs and traces.
SERVER__NAME=go-auth
# Production flag for server runtime behaviors.
SERVER__PRODUCTION=false
# Listening address for internal admin/ops endpoints (health checks, readiness, metrics).
SERVER__ADMIN_ADDR=:4040
# Graceful shutdown timeout before hard termination (e.g. 15s, 30s).
SERVER__SHUTDOWN_TIMEOUT=15s

# ------------------------------------------------------------------------------
# 3. RESTFUL API CONFIGURATION (Public HTTP Server)
# ------------------------------------------------------------------------------
# Production flag for HTTP API engine (disables debug route outputs when true).
RESTFUL_API__PRODUCTION=false
# Public HTTP API listening address.
RESTFUL_API__ADDR=:5050
# Time allowed to read HTTP request headers.
RESTFUL_API__READ_HEADER_TIMEOUT=10s
# Whole-request deadline for reading body (0s = disabled).
RESTFUL_API__READ_TIMEOUT=0s
# Whole-request deadline for writing response (0s = disabled).
RESTFUL_API__WRITE_TIMEOUT=0s
# Idle keep-alive connection timeout.
RESTFUL_API__IDLE_TIMEOUT=120s
# Comma-separated list of trusted proxy IPs/CIDRs allowed to set X-Forwarded-For (empty = none).
RESTFUL_API__TRUSTED_PROXIES=
# Comma-separated list of allowed CORS origins (empty = CORS disabled).
RESTFUL_API__CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# 4. POSTGRESQL CONFIGURATION (Required Runtime Dependency)
# ------------------------------------------------------------------------------
# PostgreSQL database connection URI (required).
POSTGRES__URL=postgres://postgres:postgres@127.0.0.1:5432/go_auth?sslmode=disable
# Maximum number of connections in the pool.
POSTGRES__MAX_CONNS=10
# Minimum number of idle connections maintained in the pool.
POSTGRES__MIN_CONNS=2
# Maximum duration a connection may be reused.
POSTGRES__MAX_CONN_LIFETIME=1h
# Maximum idle time before an unused connection is closed.
POSTGRES__MAX_CONN_IDLE_TIME=30m
# Interval between periodic health checks of pooled connections.
POSTGRES__HEALTH_CHECK_PERIOD=1m
# Timeout for establishing a new connection.
POSTGRES__CONNECT_TIMEOUT=5s

# ------------------------------------------------------------------------------
# 5. REDIS CONFIGURATION (Optional Session / Cache Store)
# ------------------------------------------------------------------------------
# Toggle Redis usage (true to enable, false to disable).
REDIS__ENABLED=false
# Standalone Redis host:port address.
REDIS__CONFIG__ADDR=127.0.0.1:6379
# Redis username (for Redis ACLs; leave blank if unauthenticated or password-only).
REDIS__CONFIG__USERNAME=
# Redis authentication password.
REDIS__CONFIG__PASSWORD=
# Redis database number (0-15).
REDIS__CONFIG__DB=0
# Enable TLS for Redis connection.
REDIS__CONFIG__TLS_ENABLED=false
# Optional TLS server name verification override.
REDIS__CONFIG__TLS_SERVER_NAME=
# Dial timeout for connecting to Redis.
REDIS__CONFIG__DIAL_TIMEOUT=5s
# Socket read timeout.
REDIS__CONFIG__READ_TIMEOUT=3s
# Socket write timeout.
REDIS__CONFIG__WRITE_TIMEOUT=3s
# Client connection pool size.
REDIS__CONFIG__POOL_SIZE=10
# Minimum number of idle connections maintained in Redis pool.
REDIS__CONFIG__MIN_IDLE_CONNS=2
# Maximum idle duration before closing idle connections.
REDIS__CONFIG__MAX_IDLE_TIME=5m
# Maximum duration a connection may exist in the pool (0s = unlimited).
REDIS__CONFIG__MAX_CONN_AGE=0s

# ------------------------------------------------------------------------------
# 6. SHARED AUTH CONFIGURATION
# ------------------------------------------------------------------------------
# Public issuer URL embedded in issued session JWT tokens ('iss' claim).
AUTH__ISSUER=http://localhost:5050
# User session token validity period.
AUTH__SESSION_TTL=720h
# Authorization code exchange lifetime.
AUTH__CODE_TTL=2m
# Temporary login attempt state lifetime.
AUTH__LOGIN_ATTEMPT_TTL=10m

# ------------------------------------------------------------------------------
# 7. OAUTH PROVIDERS - GOOGLE
# ------------------------------------------------------------------------------
AUTH__PROVIDERS__GOOGLE__ENABLED=false
AUTH__PROVIDERS__GOOGLE__CLIENT_ID=your-google-client-id.apps.googleusercontent.com
AUTH__PROVIDERS__GOOGLE__CLIENT_SECRET=your-google-client-secret
AUTH__PROVIDERS__GOOGLE__REDIRECT_URL=http://localhost:5050/auth/callback/google
AUTH__PROVIDERS__GOOGLE__SCOPES=openid,email,profile

# ------------------------------------------------------------------------------
# 8. OAUTH PROVIDERS - GITHUB
# ------------------------------------------------------------------------------
AUTH__PROVIDERS__GITHUB__ENABLED=false
AUTH__PROVIDERS__GITHUB__CLIENT_ID=your-github-client-id
AUTH__PROVIDERS__GITHUB__CLIENT_SECRET=your-github-client-secret
AUTH__PROVIDERS__GITHUB__REDIRECT_URL=http://localhost:5050/auth/callback/github
AUTH__PROVIDERS__GITHUB__SCOPES=read:user,user:email

# ------------------------------------------------------------------------------
# 9. JWT SESSION SIGNING KEY (ES256 / ECDSA P-256)
# KeyID is required when signing key is configured.
# Provide either AUTH__SIGNING_KEY__PRIVATE_KEY_PATH or AUTH__SIGNING_KEY__PRIVATE_KEY_PEM.
# ------------------------------------------------------------------------------
# Active key ID identifier ('kid' claim in JWT header).
AUTH__SIGNING_KEY__KEY_ID=local-dev
# Raw ES256 EC Private Key PEM content (multiline PEM or escaped \n).
AUTH__SIGNING_KEY__PRIVATE_KEY_PEM=
# Path to ES256 EC Private Key PEM file (e.g. ./keys/es256-private.pem).
AUTH__SIGNING_KEY__PRIVATE_KEY_PATH=
